# Copy to .env.local for local development. Production values go in Vercel.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=
# Address that receives the contact form messages
CONTACT_TO_EMAIL=
# Sender, e.g. "Portfolio <onboarding@resend.dev>" or an address on a domain verified in Resend
CONTACT_FROM_EMAIL=

# Public URL of the site, used for metadata and the sitemap (optional on Vercel)
NEXT_PUBLIC_SITE_URL=
